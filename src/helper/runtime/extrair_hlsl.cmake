if(NOT ENTRADA OR NOT SAIDA)
  message(FATAL_ERROR "extrair_hlsl: passe -DENTRADA e -DSAIDA")
endif()
file(READ "${ENTRADA}" texto)
string(FIND "${texto}" "R\"(" inicio)
if(inicio LESS 0)
  message(FATAL_ERROR "extrair_hlsl: ${ENTRADA} sem R\"(")
endif()
math(EXPR inicio "${inicio}+3")
string(SUBSTRING "${texto}" ${inicio} -1 resto)
string(FIND "${resto}" ")\"" fim)
if(fim LESS 0)
  message(FATAL_ERROR "extrair_hlsl: ${ENTRADA} sem o fim )\"")
endif()
string(SUBSTRING "${resto}" 0 ${fim} hlsl)

while(TRUE)
  math(EXPR depois "${fim}+2")
  string(SUBSTRING "${resto}" ${depois} -1 resto)
  string(REGEX MATCH "^[ \t\r\n]*R\"\\(" prox "${resto}")
  if(NOT prox)
    break()
  endif()
  string(LENGTH "${prox}" n)
  string(SUBSTRING "${resto}" ${n} -1 resto)
  string(FIND "${resto}" ")\"" fim)
  if(fim LESS 0)
    message(FATAL_ERROR "extrair_hlsl: ${ENTRADA} com um pedaco R\"( sem o fim )\"")
  endif()
  string(SUBSTRING "${resto}" 0 ${fim} pedaco)
  string(APPEND hlsl "${pedaco}")
endwhile()
file(WRITE "${SAIDA}" "${hlsl}")
